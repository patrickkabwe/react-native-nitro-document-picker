{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrodocumentpicker"],
  "ios": {
    "iosModuleName": "NitroDocumentPicker"
  },
  "android": {
    "androidNamespace": ["nitrodocumentpicker"],
    "androidCxxLibName": "NitroDocumentPicker"
  },
  "autolinking": {
    "NitroDocumentPicker": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroDocumentPicker"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroDocumentPicker"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
